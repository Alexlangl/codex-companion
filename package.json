{
  "name": "codex-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/companion-devcodex.mjs --start-client",
    "dev:companion": "node scripts/companion-devcodex.mjs --no-start-client",
    "dev:local": "node scripts/companion-devcodex.mjs --local --start-client",
    "dev:cli": "node scripts/companion-devcodex.mjs --cli --start-client",
    "dev:ui": "pnpm --filter @codex-companion/desktop dev:web",
    "dev:app": "pnpm --filter @codex-companion/desktop dev",
    "build": "pnpm --filter @codex-companion/desktop build",
    "build:tauri": "pnpm --filter @codex-companion/desktop build:tauri",
    "check": "pnpm --filter @codex-companion/desktop check",
    "rust:check": "cargo check --workspace",
    "test": "cargo test --workspace"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  }
}
