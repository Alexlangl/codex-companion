{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Companion",
  "version": "0.1.0",
  "identifier": "com.alexlangl.codex-companion",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Companion",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRUEzMTdEMDU5NDc4QjkKUldTNWVKUUZmVEhxTWV5eFNzSkd2SmxjUTZabzgvTzJiR1FZVGo2WjJWdDd3cmpyN204dDIyQTcK",
      "endpoints": [
        "https://github.com/Alexlangl/codex-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
